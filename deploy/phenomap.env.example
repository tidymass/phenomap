# PhenoMAP 内网部署配置。复制成 <部署根目录>/config/phenomap.env 后填写。
# 这是整套部署唯一的配置入口 —— 四个服务的环境变量都由 common.sh 从这里派生，
# 不会再有第二份 .env 需要同步。文件里有密码，权限保持 600。

# ================= 对外访问 =================
# 组员在浏览器里输入的地址。邮箱验证邮件里的链接也用它拼。
SITE_URL=http://10.96.129.143:3839

# 网站端口（Go backend 同时提供 API 和前端静态文件，只需要这一个对外端口）。
PORT=3839

# ================= 只监听本机的内部端口 =================
# 都不对内网暴露。改之前先确认没被别的服务占用（ss -tln | grep :端口）。
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
ENRICHMENT_PORT=8797
CHAT_PORT=8798

# ================= Neo4j =================
# 首次 bootstrap.sh 时用这个密码初始化数据库；之后改这里要同步改数据库里的密码。
NEO4J_PASSWORD=change-me
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# 这台机器 503G 内存，但网站数据只有百来兆，占多了是浪费别人的资源。
NEO4J_HEAP=4G
NEO4J_PAGECACHE=4G

# ================= 邮箱验证 (Gmail 应用专用密码) =================
# 不是 Gmail 登录密码：Google 账号 -> 安全性 -> 两步验证 -> 应用专用密码。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=phenomap.shenlab@gmail.com
SMTP_PASSWORD=
SMTP_FROM=phenomap.shenlab@gmail.com

# ================= AI Q&A (chat-service) =================
# 设为 no 就完全不启动 chat-service（网站其余功能不受影响）。
ENABLE_CHAT=yes
# 官方免费模式指向的 OpenAI 兼容推理服务。Qwen 还没起来时这个模式会报错，
# 用户自带 API key 的模式不受影响。
OFFICIAL_QWEN_API_KEY=EMPTY
OFFICIAL_QWEN_BASE_URL=http://127.0.0.1:8000/v1
OFFICIAL_QWEN_MODEL=Qwen/Qwen3.5-122B-A10B-GPTQ-Int4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
MAX_TOOL_TURNS=6
REQUEST_TIMEOUT=35
TOOL_CACHE_TTL_SECONDS=300
TOOL_CACHE_MAX_ENTRIES=500

# ================= 版本（留空=自动取最新可用版本）=================
# APOC 的发布 tag 和 Neo4j 版本一一对应，bootstrap.sh 默认取 APOC 最新
# release 的 tag，保证两者版本天然匹配。要钉死版本就在这里写死。
NEO4J_VERSION=
GO_VERSION=

# PhenoMAP 内网部署配置。复制成 <部署根目录>/config/phenomap.env 后填写。
# 这是整套部署唯一的配置入口 —— 四个服务的环境变量都由 common.sh 从这里派生，
# 不会再有第二份 .env 需要同步。文件里有密码，权限保持 600。

# ================= 对外访问 =================
# 组员在浏览器里输入的地址。邮箱验证邮件里的链接也用它拼。
SITE_URL=http://10.96.129.143:3839

# 网站端口（Go backend 同时提供 API 和前端静态文件，只需要这一个对外端口）。
PORT=3839
# 留空 = 监听所有网卡（内网直接用 IP:端口访问）。公开服务器填 127.0.0.1，只让 Nginx 反向代理访问。
LISTEN_HOST=

# ================= 只监听本机的内部端口 =================
# 都不对内网暴露。改之前先确认没被别的服务占用（ss -tln | grep :端口）。
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
ENRICHMENT_PORT=8797
CHAT_PORT=8798

# ================= Neo4j =================
# 首次 bootstrap.sh 时用这个密码初始化数据库；之后改这里要同步改数据库里的密码。
NEO4J_PASSWORD=change-me
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# 这台机器 503G 内存，但网站数据只有百来兆，占多了是浪费别人的资源。
NEO4J_HEAP=4G
NEO4J_PAGECACHE=4G

# ================= 登录功能 =================
# false：课题组内网版，不需要账号，所有分析页面直接可用，隐藏登录/注册/账号页和 Community 投稿。
# true ：公开服务器版，需要注册登录（默认值，不写就是 true）。
AUTH_ENABLED=false

# ================= 邮箱验证 (163 邮箱 SMTP 授权码) =================
# AUTH_ENABLED=false 时不会发注册/找回密码邮件，但 Contact 页的留言仍通过这里发送。
# 和 FeatureMAP 共用 featuremap@163.com。SMTP_PASSWORD 填 163 的 SMTP 授权码，不是邮箱登录密码：
# mail.163.com -> 设置 -> POP3/SMTP/IMAP -> 开启 SMTP 服务 -> 授权码。465 端口走 SSL。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=featuremap@163.com
SMTP_PASSWORD=
SMTP_FROM=featuremap@163.com

# ================= AI Q&A (chat-service) =================
# 设为 no 就完全不启动 chat-service（网站其余功能不受影响）。
ENABLE_CHAT=yes
# 两种模式都由用户在网页上填写自己的 API key，服务器不保存任何模型密钥；
# 默认是 SiliconFlow。下面只是默认的接口地址和模型名。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
MAX_TOOL_TURNS=6
REQUEST_TIMEOUT=35
TOOL_CACHE_TTL_SECONDS=300
TOOL_CACHE_MAX_ENTRIES=500

# ================= 版本（留空=自动取最新可用版本）=================
# APOC 的发布 tag 和 Neo4j 版本一一对应，bootstrap.sh 默认取 APOC 最新
# release 的 tag，保证两者版本天然匹配。要钉死版本就在这里写死。
NEO4J_VERSION=
GO_VERSION=

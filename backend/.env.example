NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j
PORT=8080
ENRICHMENT_SERVICE_URL=http://127.0.0.1:8787
CHAT_SERVICE_URL=http://127.0.0.1:8788

# --- accounts / sign in ---
AUTH_DB_PATH=phenomap_auth.db
SESSION_COOKIE_SECURE=false

# --- community study data submissions ---
# Where uploaded feature tables / sample metadata / annotation files are
# stored on disk, one subfolder per submission ID.
COMMUNITY_UPLOAD_DIR=community_uploads

# Accounts on/off. true (default) = public deployment with sign up / sign in
# and Community submissions; false = lab-internal deployment, no accounts,
# every analysis page open, account and Community pages hidden.
AUTH_ENABLED=true

# 163 Mail SMTP (same mailbox as FeatureMAP). SMTP_PASSWORD is the 163
# SMTP authorization code, not the mailbox login password:
# mail.163.com -> Settings -> POP3/SMTP/IMAP -> enable SMTP -> authorization code.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=featuremap@163.com
SMTP_PASSWORD=your-163-smtp-authorization-code
SMTP_FROM=featuremap@163.com

# Used to build links in emails (verification link points at the
# backend; the backend then redirects back to the frontend).
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_FRONTEND_URL=http://localhost:5173

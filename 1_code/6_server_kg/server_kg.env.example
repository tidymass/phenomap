# Copy this file outside Git, edit the paths, then pass it to 02_build_kg.sh.
# Do not put API keys in this file. Export OPENAI_API_KEY in the shell instead.

PHENOMAP_PROJECT_ROOT=/mnt/hdd1/home/yuting/phenomap-deploy/src

# The two directories whose immediate children are ST... and MTBLS... study
# folders containing study_meta.json and anno_result/res_sig.rda.
CASE_ROOT_MW=/path/to/metabolomics_workbench_cases
CASE_ROOT_ML=/path/to/metabolights_cases

# Use existing reviewed normalization directories when available.
PHENOTYPE_DIR_MW=/path/to/phenotype_normalization_mw
PHENOTYPE_DIR_ML=/path/to/phenotype_normalization_ml

# Set yes only when the paths above should be created from scratch. This uses
# the OpenAI API plus EBI OLS. Automatic results can build a test KG, but the
# manual-review CSV should still be reviewed before publication.
RUN_PHENOTYPE_NORMALIZATION=no
PHENOTYPE_MODEL=gpt-4.1

# Every run writes to a new isolated directory. The script refuses to use an
# already-existing directory.
BUILD_ROOT=/mnt/hdd1/home/yuting/phenomap-kg-builds/build_YYYYMMDD

# Seed stable-ID registries, the shared metabolite dictionary/MRN edges, and
# existing embedding cache from the currently deployed data.
SEED_DATA_ROOT=/mnt/hdd1/home/yuting/phenomap-deploy/src/2_data
REUSE_REFERENCE_GRAPH=yes

# Module similarity calls the embedding API only for modules not in the seed
# cache. Set no for a quick structural build without SIMILAR_TO edges.
RUN_MODULE_SIMILARITY=yes
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
MIN_MODULE_SIMILARITY=0.70

WORKERS=12

# Existing server-side R libraries and FeatureMAP source checkout.
R_LIBS_USER=/mnt/hdd1/home/yuting/phenomap-deploy/opt/rlib:/mnt/hdd1/home/yuting/featuremap-deploy/rlib
PHENOMAP_FEATUREMAP_ROOT=/mnt/hdd1/home/yuting/featuremap-deploy/src

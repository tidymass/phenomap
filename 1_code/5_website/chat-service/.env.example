BACKEND_URL=http://127.0.0.1:8080

# Official free mode. Point these to the OpenAI-compatible Qwen endpoint you
# deploy for PhenoMAP users. The browser never sees this key.
OFFICIAL_QWEN_API_KEY=EMPTY
OFFICIAL_QWEN_BASE_URL=http://10.96.129.143:8000/v1
OFFICIAL_QWEN_MODEL=Qwen/Qwen3.5-122B-A10B-GPTQ-Int4

# Defaults for user-supplied API modes. Users still provide their own API key
# in the PhenoMAP Chatbot UI for these modes.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

PORT=8788
MAX_TOOL_TURNS=6
REQUEST_TIMEOUT=35

# How long (seconds) an identical backend call is served from an in-process
# cache instead of re-querying Neo4j -- see tools.py's _cache. Safe to raise
# for a mostly-static graph; set to 0 to disable caching entirely.
TOOL_CACHE_TTL_SECONDS=300
TOOL_CACHE_MAX_ENTRIES=500

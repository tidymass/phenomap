NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j
PORT=8080
ENRICHMENT_SERVICE_URL=http://127.0.0.1:8787
CHAT_SERVICE_URL=http://127.0.0.1:8788

# --- accounts / sign in ---
AUTH_DB_PATH=phenomap_auth.db
SESSION_COOKIE_SECURE=false

# Gmail SMTP: use an App Password, not your normal Gmail password.
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ytwangzero@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM=ytwangzero@gmail.com

# Used to build links in emails (verification link points at the
# backend; the backend then redirects back to the frontend).
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_FRONTEND_URL=http://localhost:5173
